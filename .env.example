# ======================================================
# ATT RISENSE AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ======================================================

# --- Application Core ---
ENV=development
PROJECT_NAME="AttriSense AI"
LOG_LEVEL=INFO

# --- Security & JWT Authentication ---
# Generate secret key using: openssl rand -hex 32
JWT_SECRET=supersecretjwtkeyforattrisense123!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (PostgreSQL / SQLite fallback) ---
# PostgreSQL example: postgresql://user:password@localhost:5432/attrisense_db
DATABASE_URL=sqlite:///./attrisense.db

# --- Redis Caching & Queue Broker ---
REDIS_URL=redis://localhost:6379/0

# --- CORS Allowed Origins (Comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://attrisense-ai.vercel.app

# --- Frontend API Endpoint ---
VITE_API_URL=http://localhost:8000/api
