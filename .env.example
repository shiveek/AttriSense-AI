# AttriSense AI - Environment Variables Reference Configuration

# Application Environment (development / production)
ENV=production
PORT=8000

# Security Credentials
# Generate standard 256-bit secret key with `openssl rand -hex 32`
JWT_SECRET=supersecretkey_attrisense_production_change_in_render_env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL
# For SQLite (default free tier): sqlite:///./attrisense.db
# For PostgreSQL (e.g. Supabase/ElephantSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./attrisense.db

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of origins
ALLOWED_ORIGINS=https://attrisense-ai.vercel.app,http://localhost:5173,http://localhost:3000

# Frontend API URL configuration
VITE_API_URL=https://attrisense-backend.onrender.com/api
